# Copia questo file in ".env" (stessa cartella di config.yaml) e riempi solo
# le chiavi che hai. Scout legge prima le variabili d'ambiente già presenti,
# poi questo file. I valori non vengono mai scritti nel registro né nei log.
#
# Senza nessuna chiave Scout funziona lo stesso: i servizi privati si
# controllano, e le fonti che richiedono la chiave vengono saltate.

# OpenRouter: il catalogo si legge anche senza; serve per il dettaglio per provider.
OPENROUTER_API_KEY=

# fal.ai: il catalogo si legge anche senza; serve per i prezzi.
FAL_KEY=

# Replicate: obbligatorio per qualunque chiamata.
REPLICATE_API_TOKEN=
